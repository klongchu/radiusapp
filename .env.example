# Shared config — docker compose auto-loads this file for ${VAR} substitution.
# HOST_IP is (re)written by: HOST_IP=$(bash ./backend/hostip.sh); see README.
HOST_IP=localhost

# DB — one source of truth for database, backend, radapi
DB_HOST=database
DB_PORT=5432
DB_NAME=radius
DB_USER=radius
DB_PASSWORD=1234
