# Shared config — docker compose auto-loads this file for ${VAR} substitution.

# DB — one source of truth for database and radapi
DB_HOST=database
DB_PORT=5432
DB_NAME=radius
DB_USER=radius
DB_PASSWORD=1234

# radapi — required, sent as the X-API-Key request header. Change this.
API_KEY=change-me
TZ=Asia/Bangkok